   "boundElements": [],
   "updated": 1763300000000,
   "link": null,
   "locked": false,
   "text": "The state is encoded a single time and its prefix cache\nreused for every question in the request (SGLang or vLLM).",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The state is encoded a single time and its prefix cache\nreused for every question in the request (SGLang or vLLM).",
