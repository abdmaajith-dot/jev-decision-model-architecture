   "isDeleted": false,
   "boundElements": [],
   "updated": 1763300000000,
   "link": null,
   "locked": false,
   "text": "SFT on (state, question, options) → correct option. Then\nRLCD — Reinforcement Learning for Calibrated Decisions —\nso that p matches how often it is actually right.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SFT on (state, question, options) → correct option. Then\nRLCD — Reinforcement Learning for Calibrated Decisions —\nso that p matches how often it is actually right.",
   "lineHeight": 1.25,
   "baseline": 11.7
  },
