   "boundElements": [],
   "updated": 1763300000000,
   "link": null,
   "locked": false,
   "text": "One readout position per question. Score each option's own\ntokens, softmax the scores → a probability distribution.\nNo text is ever written.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One readout position per question. Score each option's own\ntokens, softmax the scores → a probability distribution.\nNo text is ever written.",
   "lineHeight": 1.25,
   "baseline": 11.7
  },
